{
  "name": "sorte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @sorte/web",
    "dev:desktop": "npm run dev -w @sorte/desktop",
    "tauri": "npm run tauri -w @sorte/desktop --",
    "typecheck": "tsc -p packages/core && tsc -p packages/ui && tsc -p apps/web && tsc -p apps/desktop",
    "test": "vitest run",
    "build:web": "npm run build -w @sorte/web",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:version": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
