; the middle pages (folder, progress) with the system colours regardless.
!define MUI_BGCOLOR "0A0A14"
!define MUI_TEXTCOLOR "FFFFFF"
!define MUI_INSTFILESPAGE_COLORS "FFFFFF 0A0A14"
!define MUI_INSTFILESPAGE_PROGRESSBAR "smooth"
